# Production values for socialscope.co — copy to .env on the server and fill in secrets
NODE_ENV=production
PORT=4000
API_PREFIX=/api/v1
APP_NAME=SocialScope
API_URL=https://api.socialscope.co
FRONTEND_URL=https://socialscope.co
# Shares auth cookies between socialscope.co and api.socialscope.co
COOKIE_DOMAIN=.socialscope.co

DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=socialscope
DB_LOGGING=false
DB_SSL=true

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=30
ENCRYPTION_KEY=

CREATOR_REGISTRATION_FEE_CENTS=300
CURRENCY=usd
FOUNDING_CREATOR_FREE_SLOTS=500
GUEST_SEARCH_LIMIT=3
WEEKLY_FREE_SEARCH_LIMIT=15

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

SOCIAL_OAUTH_MOCK=false
SOCIAL_SYNC_CRON=0 */12 * * *
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
